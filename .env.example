# Copy to .env and enable only the sources and notifiers you need.
# cp .env.example .env

# Seconds between polling cycles across all enabled sources.
# SLEEP_DELAY=600

# Log verbosity: DEBUG, INFO, WARNING, or ERROR.
# LOG_LEVEL=INFO


# LLM classification for RSS, Twitter, Telegram, and POST /webhook/news.
# Provider name or comma-separated fallback chain: openai, openrouter.
# Example: openrouter,openai tries OpenRouter first, then OpenAI on failure.
# CLASSIFICATION_PROCESSOR=openai

# Path to the classification prompt template. Must contain a <content>
# placeholder replaced with the item text before sending to the LLM.
# PROMPT_FILE=./prompt.txt

# OpenAI API key. Required when openai is in CLASSIFICATION_PROCESSOR.
OPENAI_API_KEY=

# OpenAI chat model name.
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter API key. Required when openrouter is in CLASSIFICATION_PROCESSOR.
OPENROUTER_API_KEY=

# Model slug on OpenRouter.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenRouter API base URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# Space-separated RSS feed URLs. One feed is polled per URL. Unset = disabled.
RSS_URLS="https://www.rp.pl/rss_main"

# TwitterAPI.io key and space-separated handles (@ optional). Both required
# to enable Twitter/X monitoring.
TWITTERAPI_KEY=
TWITTERAPI_USERNAMES=

# TwitterAPI.io API host.
# TWITTERAPI_BASE_URL=https://api.twitterapi.io


# Telegram channel monitoring (Telethon user account — reads public channels).
# API credentials from https://my.telegram.org. Also requires telegram.yaml.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Path to the YAML file listing channels and optional regex filters.
# TELEGRAM_CHANNELS_FILE=./telegram.yaml

# File-based Telethon session (default). Do not run telegram_login.py while
# war-alert holds this file.
# TELEGRAM_SESSION_FILE=telegram.session

# Optional StringSession for Docker or environments without a writable session
# file. Run telegram_login.py once to print the value.
# TELEGRAM_SESSION_STRING=

# Phone number for telegram_login.py (E.164, e.g. +48123456789). Skips the
# interactive phone prompt when set.
# TELEGRAM_PHONE=+48123456789


# FAA NMS API credentials. Both required to enable Polish NOTAM monitoring.
# Register at https://notams.aim.faa.gov/nmsapi/
FAA_NMS_CLIENT_ID=
FAA_NMS_CLIENT_SECRET=

# FAA NMS API base URL (production by default).
# FAA_NMS_BASE_URL=https://api-nms.aim.faa.gov/nmsapi

# OAuth token endpoint for FAA NMS.
# FAA_NMS_AUTH_URL=https://api-nms.aim.faa.gov/v1/auth/token

# Space-separated ICAO location codes to query (e.g. FIR and aerodrome).
# NOTAM_LOCATIONS=EPWW EPWA

# Comma-separated NOTAM Q-code prefixes that may trigger an alert.
# NOTAM_QCODES=QATLC,QRTCA,QRTCL,QRRCA,QRPCA,QRMXX

# Q-code prefixes that always alert and skip the text-exclude filter
# (TMA/CTR closures and Ukraine NPZ notices by default).
# NOTAM_PASSTHROUGH_QCODES=QATLC,QRPCA

# Comma-separated substrings; matching NOTAMs are dropped unless their Q-code
# is in NOTAM_PASSTHROUGH_QCODES. Set to empty to disable text filtering.
# NOTAM_TEXT_EXCLUDE=PJE,PARAGLID,UAV FLT,UAS FLT,UNMANNED AERIAL VEHICLES FLIGHTS,AIRSPACE USE PLAN,AUP,AIP SUP,AREA MANAGER,TEMPORARY RESERVED,TEMPORARY RESTRICTED,AVBL FOR REQUEST,TEMPORARY AVBL

# Optional FAA API classification filter: INTERNATIONAL, DOMESTIC, MILITARY,
# LOCAL_MILITARY, or FDC. Unset = all active NOTAMs.
# NOTAM_CLASSIFICATION=

# Seconds between NOTAM location queries (staging API enforces ~1 req/s).
# NOTAM_REQUEST_DELAY=1.1


# Alerts.in.ua API token. Unset = disabled.
ALERTSUA_TOKEN=

# Comma-separated alert types to include. Unset = all active alert types.
# ALERTSUA_FILTER_TYPES=air_raid,chemical,nuclear

# Comma-separated Ukrainian oblast names to include. Unset = all regions.
# ALERTSUA_FILTER_REGIONS=Львівська область,Волинська область


# Outbound Telegram notifications via Bot API (separate from Telethon above).
# Bot token from @BotFather and target channel or chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Minimum seconds between Telegram Bot API sends. Throttles bursts (e.g. many
# NOTAMs on first poll) to avoid HTTP 429 rate limits.
# TELEGRAM_MIN_INTERVAL=1.0

# Pushover application token and user key. PUSHOVER_TOKEN enables the notifier;
# both values are sent to the Pushover API.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ntfy topic name. On ntfy.sh the topic acts as a password. Unset = disabled.
NTFY_TOPIC=

# ntfy server base URL.
# NTFY_URL=https://ntfy.sh

# Bearer token for reserved or authenticated ntfy topics.
# NTFY_TOKEN=

# ntfy Priority header value (e.g. min, low, default, high, urgent).
# NTFY_PRIORITY=high

# Comma-separated ntfy Tags header (emoji short codes or plain tags).
# NTFY_TAGS=

# Email notifications. Both addresses required to enable email; one NotifierEmail
# is created per space-separated recipient in EMAIL_TO.
EMAIL_FROM=""
EMAIL_TO=""

# SMTP server hostname.
# SMTP_SERVER=smtp.example.com

# SMTP port (STARTTLS on 587 by default).
# SMTP_PORT=587

# SMTP authentication credentials.
# SMTP_LOGIN=your.email@example.com
# SMTP_PASSWORD=your_password


# HTTP server for health checks and inbound webhooks. Set either variable to
# start the server; docker-compose sets both to 8080 inside the container.
# HEALTH_PORT=8080
# WEBHOOK_PORT=8080

# Bearer token for POST /webhook/alert and POST /webhook/news. Required when
# WEBHOOK_PORT is set. Send as: Authorization: Bearer <WEBHOOK_SECRET>
WEBHOOK_SECRET=your-secret-token-here


# Docker Compose network name. Default creates a project network named war-alert.
# DOCKER_NETWORK=war-alert

# Set to true when DOCKER_NETWORK is an existing external network (e.g. for
# nginx reverse proxy attachment).
# DOCKER_NETWORK_EXTERNAL=false
