# Copy to .env and enable only the sources and notifiers you need.
# cp .env.example .env
#
# Frequently changed options live in war-alert.yml — see war-alert.example.yml.

# Log verbosity: DEBUG, INFO, WARNING, or ERROR.
# LOG_LEVEL=INFO


# OpenAI API key. Required when openai is in classification.processor.
OPENAI_API_KEY=

# OpenRouter API key. Required when openrouter is in classification.processor.
OPENROUTER_API_KEY=

# OpenRouter API base URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# TwitterAPI.io key. Required with twitter.usernames in war-alert.yml.
TWITTERAPI_KEY=

# TwitterAPI.io API host.
# TWITTERAPI_BASE_URL=https://api.twitterapi.io


# Telegram channel monitoring (Telethon user account — reads public channels).
# API credentials from https://my.telegram.org. Channel list is in war-alert.yml.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# File-based Telethon session (default). Do not run telegram_login.py while
# war-alert holds this file.
# TELEGRAM_SESSION_FILE=telegram.session

# Optional StringSession for Docker or environments without a writable session
# file. Run telegram_login.py once to print the value.
# TELEGRAM_SESSION_STRING=

# Phone number for telegram_login.py (E.164, e.g. +48123456789). Skips the
# interactive phone prompt when set.
# TELEGRAM_PHONE=+48123456789


# FAA NMS API credentials. Both required to enable Polish NOTAM monitoring.
# Register at https://notams.aim.faa.gov/nmsapi/
FAA_NMS_CLIENT_ID=
FAA_NMS_CLIENT_SECRET=

# FAA NMS API base URL (production by default).
# FAA_NMS_BASE_URL=https://api-nms.aim.faa.gov/nmsapi

# OAuth token endpoint for FAA NMS.
# FAA_NMS_AUTH_URL=https://api-nms.aim.faa.gov/v1/auth/token

# Seconds between NOTAM location queries (staging API enforces ~1 req/s).
# NOTAM_REQUEST_DELAY=1.1


# Alerts.in.ua API token. Unset = disabled.
ALERTSUA_TOKEN=


# Outbound Telegram notifications via Bot API (separate from Telethon above).
# Bot token from @BotFather and target channel or chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Minimum seconds between Telegram Bot API sends. Throttles bursts (e.g. many
# NOTAMs on first poll) to avoid HTTP 429 rate limits.
# TELEGRAM_MIN_INTERVAL=1.0

# Pushover application token and user key. PUSHOVER_TOKEN enables the notifier;
# both values are sent to the Pushover API.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ntfy topic name. On ntfy.sh the topic acts as a password. Unset = disabled.
NTFY_TOPIC=

# ntfy server base URL.
# NTFY_URL=https://ntfy.sh

# Bearer token for reserved or authenticated ntfy topics.
# NTFY_TOKEN=


# Email notifications. EMAIL_FROM and SMTP settings are required to enable
# email; recipients are listed in war-alert.yml under email.to.
EMAIL_FROM=""

# SMTP server hostname.
# SMTP_SERVER=smtp.example.com

# SMTP port (STARTTLS on 587 by default).
# SMTP_PORT=587

# SMTP authentication credentials.
# SMTP_LOGIN=your.email@example.com
# SMTP_PASSWORD=your_password


# HTTP server for health checks and inbound webhooks. Set either variable to
# start the server; docker-compose sets both to 8080 inside the container.
# HEALTH_PORT=8080
# WEBHOOK_PORT=8080

# Bearer token for POST /webhook/alert and POST /webhook/news. Required when
# WEBHOOK_PORT is set. Send as: Authorization: Bearer <WEBHOOK_SECRET>
WEBHOOK_SECRET=your-secret-token-here


# Docker Compose network name. Default creates a project network named war-alert.
# DOCKER_NETWORK=war-alert

# Set to true when DOCKER_NETWORK is an existing external network (e.g. for
# nginx reverse proxy attachment).
# DOCKER_NETWORK_EXTERNAL=false
